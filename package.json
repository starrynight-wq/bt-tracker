{
  "name": "bt-tracker",
  "version": "1.1.0",
  "description": "Deployable BitTorrent tracker for Cloudflare Workers / Pages and Replit. HTTP/HTTPS announce/scrape plus external-tracker merging, admin import/export and dashboard.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "smoke": "node scripts/e2e-smoke.mjs",
    "deploy:cf": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy --config wrangler.pages.toml"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {},
  "devDependencies": {}
}
